{
  "name": "brickxinator-frontend",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "playwright test",
    "format": "prettier --write src tests playwright.config.ts vite.config.ts tsconfig.json index.html",
    "format:check": "prettier --check src tests playwright.config.ts vite.config.ts tsconfig.json index.html"
  },
  "dependencies": {
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
